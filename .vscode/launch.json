{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mobile Template (DEV)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "args": [
                "--flavor",
                "development",
                "--web-port=8080",
                "--web-browser-flag=--user-data-dir=${workspaceFolder}/.dart_tool/chrome_dev_profile"
            ],
            "toolArgs": [
                "--dart-define-from-file=.env.dev"
            ]
        },
        {
            "name": "Mobile Template (PROD)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "production",
                "--web-port=8080",
                "--web-browser-flag=--user-data-dir=${workspaceFolder}/.dart_tool/chrome_dev_profile"
            ],
            "toolArgs": [
                "--dart-define-from-file=.env.prod"
            ]
        }
    ]
}