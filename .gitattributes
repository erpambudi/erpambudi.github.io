# Set default behavior to automatically normalize line endings to LF (Linux/macOS style)
* text=auto eol=lf

# Explicitly declare text files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.arb text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
